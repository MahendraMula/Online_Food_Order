# ============================================================
#  OFO-DBMS — Environment Variables Configuration
#  Copy this file to .env for local development or configure
#  these keys in Azure App Service Configuration (Application Settings).
#  NEVER commit actual secret keys to version control.
# ============================================================

# --- Django Core ---
# In production, DJANGO_SECRET_KEY is mandatory and cannot use default fallback keys.
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-production-secret-key-at-least-50-characters-long

# Set to False in production (enforces SSL, cookies, HSTS, and secret key validation)
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames
# For Azure App Service: your-app-name.azurewebsites.net,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,*.azurewebsites.net

# --- Security (Production only — active when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# --- Commercial & Dynamic Pricing Configuration ---
OFO_CURRENCY_SYMBOL=₹
OFO_CURRENCY_CODE=INR
OFO_BASE_DELIVERY_FEE=4.00
OFO_FREE_DELIVERY_THRESHOLD=50.00
OFO_DELIVERY_PER_KM_RATE=1.00
OFO_BASE_DELIVERY_DISTANCE_KM=5.0
OFO_GST_TAX_RATE=0.05

# --- Production Gunicorn Worker Settings (Azure Linux) ---
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=600
GUNICORN_LOGLEVEL=info
